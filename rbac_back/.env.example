# ====================
# Django 基础配置
# ====================

DJANGO_SECRET_KEY=请替换为随机密钥
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# ====================
# MySQL 数据库配置
# ====================

DB_NAME=数据库名称
DB_USER=数据库用户
DB_PASSWORD=数据库密码
DB_HOST=127.0.0.1
DB_PORT=3306

# ====================
# 数据库连接池配置
# ====================

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_RECYCLE_SECONDS=86400
DB_TIMEOUT_SECONDS=30